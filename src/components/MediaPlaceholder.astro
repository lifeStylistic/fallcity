---
/* ===========================================================================
   MEDIA PLACEHOLDER
   ---------------------------------------------------------------------------
   HOW TO REPLACE A PLACEHOLDER WITH A REAL PHOTO:
     1. Drop the image into  public/images/   (e.g. public/images/hero.jpg)
     2. Find the <MediaPlaceholder ... /> tag in the section component
     3. Replace the whole tag with:
          <img src="/images/hero.jpg" alt="Describe the photo for screen
               readers — say what is happening, not 'photo of track'"
               width="1600" height="900" loading="lazy" />
   Every placeholder below names exactly which photo belongs there.

   Props:
     label   — the bracketed slot name, e.g. "[HERO IMAGE – CURRENT TRACK]"
     note    — art-direction guidance for whoever supplies the photo
     ratio   — CSS aspect-ratio, default 16/9
     variant — 'light' | 'dark' | 'gold'
     kind    — 'image' | 'video'
=========================================================================== */
const {
  label,
  note = '',
  ratio = '16 / 9',
  variant = 'light',
  kind = 'image',
  class: className = '',
} = Astro.props;
---

<figure class={`media media--${variant} ${className}`} style={`--ratio:${ratio}`}>
  <div class="media__inner">
    <div class="media__marks" aria-hidden="true">
      <span></span><span></span><span></span><span></span>
    </div>
    <div class="media__body">
      <span class="media__kind" aria-hidden="true">
        {kind === 'video' ? '▶' : '◻'}
      </span>
      <p class="media__label">{label}</p>
      {note && <p class="media__note">{note}</p>}
    </div>
  </div>
</figure>

<style>
  .media { margin: 0; width: 100%; }

  .media__inner {
    position: relative;
    aspect-ratio: var(--ratio);
    display: grid;
    place-items: center;
    padding: var(--space-md);
    overflow: hidden;
    border: 1px dashed var(--line);
    background:
      repeating-linear-gradient(
        135deg,
        transparent 0 14px,
        rgba(75, 46, 131, 0.035) 14px 15px
      ),
      var(--tint);
  }

  /* Four lane marks running the height of the frame — the motif again,
     so even an empty placeholder looks deliberate rather than unfinished. */
  .media__marks {
    position: absolute; inset: 0;
    display: grid; grid-template-columns: repeat(4, 1fr);
  }
  .media__marks span { border-right: 1px solid rgba(75, 46, 131, 0.08); }
  .media__marks span:last-child { border-right: 0; }

  .media__body { position: relative; text-align: center; max-width: 34ch; }

  .media__kind {
    display: block;
    font-size: 1.1rem;
    color: var(--purple);
    opacity: 0.55;
    margin-bottom: 0.85rem;
  }

  .media__label {
    font-family: var(--font-body);
    font-size: var(--fs-small);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--purple);
    line-height: 1.45;
  }

  .media__note {
    margin-top: 0.6rem;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--muted);
  }

  /* Dark variant — for placeholders sitting on ink or purple sections. */
  .media--dark .media__inner {
    border-color: rgba(255, 255, 255, 0.22);
    background:
      repeating-linear-gradient(
        135deg,
        transparent 0 14px,
        rgba(255, 255, 255, 0.04) 14px 15px
      ),
      rgba(255, 255, 255, 0.04);
  }
  .media--dark .media__marks span { border-right-color: rgba(255, 255, 255, 0.09); }
  .media--dark .media__label { color: var(--gold); }
  .media--dark .media__kind  { color: var(--gold); opacity: 0.7; }
  .media--dark .media__note  { color: rgba(255, 255, 255, 0.6); }

  .media--gold .media__inner {
    border-color: rgba(201, 154, 22, 0.4);
    background:
      repeating-linear-gradient(
        135deg,
        transparent 0 14px,
        rgba(201, 154, 22, 0.07) 14px 15px
      ),
      #FDF8E9;
  }
  .media--gold .media__marks span { border-right-color: rgba(201, 154, 22, 0.14); }
</style>
