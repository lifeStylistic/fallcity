---
/* ===========================================================================
   SITE SCHEMATIC
   ---------------------------------------------------------------------------
   Original drawing. Nothing here is traced from or derived from mapping
   imagery, so there is no third-party licence attached to it.

   IT IS DELIBERATELY NOT TO SCALE, and says so inside the graphic rather than
   only in a caption, so the caveat travels with the image if someone
   screenshots it. It shows how the elements of the site RELATE to one
   another — the loop around the field, the river along two sides, the school
   set apart from the field. It does not represent measured dimensions,
   because none exist yet: establishing them is exactly what Phase 1 is for,
   and the executive summary declines to claim a confirmed layout until then.

   IF YOU EDIT THIS: keep the "not to scale" stamp, and do not add
   measurements, lane widths or radii. A drawing that looks surveyed implies
   confirmed geometry the project does not have. Replace the whole thing with
   a real drawing once the civil engineer produces one.

   The running loop is drawn as five concentric lines making four lanes,
   which is the site's recurring graphic device used as information.
=========================================================================== */
const keyItems = [
  { n: 1, label: 'Existing loop', body: 'Dirt and gravel, no defined lanes, no formal drainage. The planned four-lane track follows this route.' },
  { n: 2, label: 'Football field', body: 'Also the established emergency Life Flight landing area, which any redevelopment must preserve.' },
  { n: 3, label: 'Little Luckiamute River', body: 'Wraps the west and south sides of the site. Relevant to both drainage design and the footprint available.' },
  { n: 4, label: 'Tree line', body: 'Closes in behind the river, further constraining the usable area.' },
  { n: 5, label: 'Falls City High School', body: 'The 1921 building, set apart from the field.' },
];
---

<figure class="plan">
  <svg
    class="plan__svg"
    viewBox="0 0 800 600"
    role="img"
    aria-labelledby="plan-title plan-desc"
  >
    <title id="plan-title">Schematic site plan of the Falls City High School athletic field</title>
    <desc id="plan-desc">
      A not-to-scale diagram showing a running loop encircling the football
      field, which doubles as the emergency helicopter landing area. The
      Little Luckiamute River runs along the west and south sides of the site
      with a tree line behind it, and the school building sits apart to the
      north-west.
    </desc>

    <rect width="800" height="600" fill="var(--paper)" />

    <!-- Tree line: clusters rather than a solid band, so it reads as
         vegetation without pretending to a mapped boundary. -->
    <g class="plan__trees" aria-hidden="true">
      <circle cx="46" cy="196" r="15" /><circle cx="34" cy="238" r="12" />
      <circle cx="52" cy="278" r="16" /><circle cx="36" cy="320" r="11" />
      <circle cx="58" cy="360" r="14" /><circle cx="44" cy="402" r="12" />
      <circle cx="78" cy="440" r="15" /><circle cx="122" cy="480" r="13" />
      <circle cx="176" cy="512" r="16" /><circle cx="238" cy="536" r="12" />
      <circle cx="304" cy="550" r="15" /><circle cx="372" cy="558" r="11" />
      <circle cx="440" cy="556" r="14" /><circle cx="508" cy="546" r="12" />
      <circle cx="572" cy="530" r="16" /><circle cx="634" cy="506" r="13" />
      <circle cx="688" cy="474" r="15" /><circle cx="730" cy="436" r="12" />
      <circle cx="758" cy="392" r="14" /><circle cx="742" cy="150" r="13" />
      <circle cx="700" cy="126" r="16" /><circle cx="652" cy="112" r="11" />
      <circle cx="596" cy="104" r="14" /><circle cx="536" cy="100" r="12" />
    </g>

    <!-- The Little Luckiamute River, along the west and south. -->
    <path
      class="plan__creek"
      d="M 96 150 C 44 250, 46 372, 132 452 C 244 552, 512 566, 656 494 C 712 466, 754 424, 782 372"
      fill="none"
    />

    <!-- Field, and the loop around it: five concentric lines = four lanes. -->
    <g class="plan__loop" aria-hidden="true">
      <rect x="170" y="185" width="500" height="290" rx="145" />
      <rect x="181" y="196" width="478" height="268" rx="134" />
      <rect x="192" y="207" width="456" height="246" rx="123" />
      <rect x="203" y="218" width="434" height="224" rx="112" />
      <rect x="214" y="229" width="412" height="202" rx="101" />
    </g>

    <rect class="plan__field" x="252" y="256" width="336" height="148" rx="2" />

    <!-- Life Flight landing area, marked over the field. -->
    <g class="plan__lz" aria-hidden="true">
      <rect x="360" y="288" width="120" height="84" rx="2" />
      <path d="M 392 306 v 48 M 448 306 v 48 M 392 330 h 56" />
    </g>

    <!-- School building and the path down to the field. -->
    <rect class="plan__school" x="64" y="74" width="128" height="76" rx="3" />
    <path class="plan__path" d="M 128 150 C 132 200, 168 232, 214 258" fill="none" />

    <!-- North arrow. -->
    <g class="plan__north" aria-hidden="true">
      <path d="M 746 62 l 13 32 l -13 -9 l -13 9 z" />
      <text x="746" y="118" text-anchor="middle">N</text>
    </g>

    <!-- Numbered markers, keyed to the list beneath the drawing. -->
    <g class="plan__marks" aria-hidden="true">
      <g><circle cx="196" cy="330" r="15" /><text x="196" y="336">1</text></g>
      <g><circle cx="300" cy="330" r="15" /><text x="300" y="336">2</text></g>
      <g><circle cx="118" cy="470" r="15" /><text x="118" y="476">3</text></g>
      <g><circle cx="330" cy="556" r="15" /><text x="330" y="562">4</text></g>
      <g><circle cx="128" cy="112" r="15" /><text x="128" y="118">5</text></g>
    </g>

    <!-- The caveat lives inside the artwork so it survives a screenshot. -->
    <text class="plan__stamp" x="34" y="44">SCHEMATIC — NOT TO SCALE</text>
    <text class="plan__stampSub" x="34" y="66">
      Relationships only. Dimensions to be established by survey.
    </text>
  </svg>

  <figcaption class="plan__caption">
    <ol class="plan__key">
      {keyItems.map((k) => (
        <li>
          <span class="plan__keyNum" aria-hidden="true">{k.n}</span>
          <span class="plan__keyText">
            <strong>{k.label}.</strong> {k.body}
          </span>
        </li>
      ))}
    </ol>
  </figcaption>
</figure>

<style>
  .plan { margin: 0; }

  .plan__svg {
    width: 100%;
    height: auto;
    display: block;
    border: 1px solid rgba(75, 46, 131, 0.10);
    border-radius: var(--radius-lg);
    background: var(--paper);
    box-shadow: var(--shadow-md);
  }

  .plan__trees circle { fill: var(--purple); opacity: 0.09; }

  .plan__creek {
    stroke: var(--purple);
    stroke-width: 5;
    opacity: 0.32;
    stroke-linecap: round;
  }

  /* Four lanes, drawn as five concentric lines — the site's motif used to
     carry information rather than decorate. */
  .plan__loop rect {
    fill: none;
    stroke: var(--purple);
    stroke-width: 2;
  }
  .plan__loop rect:first-child { stroke-width: 3; }

  .plan__field { fill: var(--tint); stroke: var(--purple); stroke-width: 1.5; opacity: 0.95; }

  .plan__lz rect { fill: none; stroke: var(--gold-deep); stroke-width: 2.5; stroke-dasharray: 9 7; }
  .plan__lz path { fill: none; stroke: var(--gold-deep); stroke-width: 7; stroke-linecap: square; }

  .plan__school { fill: var(--purple); opacity: 0.9; }
  .plan__path { stroke: var(--muted); stroke-width: 2; stroke-dasharray: 5 6; opacity: 0.7; }

  .plan__north path { fill: var(--ink); }
  .plan__north text {
    fill: var(--ink); font-family: var(--font-body);
    font-size: 21px; font-weight: 700;
  }

  .plan__marks circle { fill: var(--purple); }
  .plan__marks text {
    fill: #fff; font-family: var(--font-body);
    font-size: 17px; font-weight: 700; text-anchor: middle;
  }

  .plan__stamp {
    fill: var(--purple); font-family: var(--font-body);
    font-size: 19px; font-weight: 700; letter-spacing: 0.1em;
  }
  .plan__stampSub {
    fill: var(--muted); font-family: var(--font-body); font-size: 15px;
  }

  /* Key sits in HTML rather than inside the SVG, so it stays legible and
     selectable at phone widths where SVG text would shrink to nothing. */
  .plan__caption { margin-top: var(--space-md); }
  .plan__key { display: grid; gap: 0.75rem; counter-reset: none; }
  .plan__key li { display: flex; gap: 0.7rem; align-items: flex-start; }

  .plan__keyNum {
    flex: none;
    width: 1.5rem; height: 1.5rem;
    display: grid; place-items: center;
    background: var(--purple); color: #fff;
    border-radius: 50%;
    font-size: 0.75rem; font-weight: 700;
    margin-top: 0.1rem;
  }
  .plan__keyText { font-size: var(--fs-small); line-height: 1.5; color: var(--muted); }
  .plan__keyText strong { color: var(--ink); }

  /* Deliberately single column at every width. This component sits in a
     narrow layout column, so a two-column key produces a ~230px measure and
     the text wraps every few words. */
</style>
