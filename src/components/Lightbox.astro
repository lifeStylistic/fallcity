---
/* ===========================================================================
   LIGHTBOX
   ---------------------------------------------------------------------------
   Opens one image full-screen, with a zoom that goes to the file's native
   pixels so fine drawing text can actually be read.

   PROGRESSIVE BY DESIGN: what renders is an ordinary link straight to the
   image file. With JavaScript off — or before the script runs — clicking it
   opens the image, which is a perfectly good outcome. The script only
   upgrades that link into a dialog.

   The behaviour lives in Base.astro, not here. Astro dedupes a component's
   <style> but not its inline <script>, so with three lightboxes on a page
   this file would ship three copies of the same IIFE and bind every handler
   three times over.

   Built on <dialog> deliberately: showModal() gives the focus trap, the
   Escape handler, the inert background and the focus restore for free, and
   the top layer escapes both the ancestor transforms of the reveal system
   and the body's overflow-x: clip. Hand-rolling any of that would be worse.
=========================================================================== */
const {
  id,
  src,
  alt,
  width,
  height,
  linkText,
  caption = '',
  note = '',
} = Astro.props;
---

<a class="lbLink" href={src} data-lightbox={id}>
  <svg class="lbLink__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5"
          stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
  <span>{linkText}</span>
</a>

<dialog class="lb" id={id} aria-label={linkText}>
  <div class="lb__bar">
    <p class="lb__title">{linkText}</p>
    <div class="lb__tools">
      <button class="lb__btn" type="button" data-lb-zoom aria-pressed="false">
        Zoom in
      </button>
      <button class="lb__btn lb__btn--close" type="button" data-lb-close>
        <span class="visually-hidden">Close</span>
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" width="18" height="18">
          <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </div>

  <div class="lb__stage" data-lb-stage>
    {/* lazy: a closed dialog still costs a download otherwise, and these
        sheets are ~900KB each. */}
    <img src={src} alt={alt} width={width} height={height} loading="lazy" decoding="async" />
  </div>

  {(caption || note) && (
    <div class="lb__foot">
      {caption && <p class="lb__caption">{caption}</p>}
      {note && <p class="lb__note">{note}</p>}
    </div>
  )}
</dialog>

<style>
  /* --- the trigger ------------------------------------------------------ */
  .lbLink {
    display: inline-flex; align-items: center; gap: 0.55rem;
    margin-top: var(--space-md);
    font-size: var(--fs-small); font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--gold);
    text-decoration: none;
    padding: 0.6rem 0.95rem 0.6rem 0.8rem;
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: var(--radius);
    background: rgba(255, 255, 255, 0.04);
    transition:
      background var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease),
      transform var(--dur-fast) var(--ease);
  }
  .lbLink:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.4);
    transform: translateY(-1px);
  }
  .lbLink__icon { width: 1rem; height: 1rem; flex: none; }

  /* --- the dialog ------------------------------------------------------- */
  .lb {
    width: 100vw; max-width: 100vw;
    height: 100dvh; max-height: 100dvh;
    margin: 0; padding: 0; border: 0;
    background: #140d24;
    color: #fff;
    /* grid, not flow: the stage takes whatever the bar and footer leave, so
       the image is never pushed off the bottom of the screen. */
    display: grid;
    /* minmax(0, 1fr), not 1fr: a bare 1fr floors at the row's content size,
       which leaves the stage without a definite height — and a percentage
       max-height on the image then resolves to none, so a tall drawing
       overflowed and its title block was clipped away. */
    grid-template-rows: auto minmax(0, 1fr) auto;
    overflow: hidden;
  }
  .lb:not([open]) { display: none; }
  .lb::backdrop { background: rgba(10, 6, 18, 0.92); }

  .lb__bar {
    display: flex; align-items: center; justify-content: space-between;
    gap: var(--space-md);
    padding: 0.85rem var(--gutter);
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }
  .lb__title {
    font-size: var(--fs-eyebrow); font-weight: 700;
    letter-spacing: 0.16em; text-transform: uppercase;
    color: var(--gold);
  }
  .lb__tools { display: flex; align-items: center; gap: 0.5rem; flex: none; }

  .lb__btn {
    font: inherit; font-size: 0.78rem; font-weight: 600;
    color: #fff; background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: var(--radius);
    padding: 0.5rem 0.85rem;
    cursor: pointer;
    transition: background var(--dur-fast) var(--ease);
  }
  .lb__btn:hover { background: rgba(255, 255, 255, 0.18); }
  .lb__btn--close { display: grid; place-items: center; padding: 0.5rem; }

  /* --- the image stage -------------------------------------------------- */
  .lb__stage {
    overflow: auto;
    min-height: 0;
    /* An explicit minmax(0, 1fr) track, not an implicit auto one. The image is
       a grid item, so its max-height: 100% resolves against its grid AREA — and
       an auto row sizes itself to the image, which makes the constraint
       circular and lets a tall drawing overflow the clipped dialog, taking its
       title block with it. A definite track breaks the loop. */
    display: grid;
    grid-template: minmax(0, 1fr) / minmax(0, 1fr);
    place-items: center;
    padding: var(--space-md);
    /* Let touch users pinch the drawing rather than trapping the gesture. */
    touch-action: pan-x pan-y pinch-zoom;
    -webkit-overflow-scrolling: touch;
  }
  .lb__stage img {
    max-width: 100%; max-height: 100%;
    width: auto; height: auto;
    object-fit: contain;
    border-radius: var(--radius);
    cursor: zoom-in;
  }
  /* Zoomed: native pixels, and the stage becomes the scroll window. */
  .lb__stage.is-zoomed { place-items: start; }
  .lb__stage.is-zoomed img {
    max-width: none; max-height: none;
    width: var(--natural-width);
    cursor: grab;
    border-radius: 0;
  }
  .lb__stage.is-panning img { cursor: grabbing; }

  .lb__foot {
    padding: 0.9rem var(--gutter) 1.15rem;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    display: grid; gap: 0.4rem;
  }
  .lb__caption {
    font-size: var(--fs-small); line-height: 1.5;
    color: rgba(255, 255, 255, 0.86);
    max-width: 80ch;
  }
  /* The standing caveat. Held at a readable contrast on purpose — this is the
     line that keeps the drawing from reading as a confirmed design. */
  .lb__note {
    font-size: 0.78rem; line-height: 1.5;
    color: rgba(255, 255, 255, 0.68);
    max-width: 80ch;
    padding-left: 0.7rem;
    border-left: 2px solid var(--gold);
  }

  @media (max-width: 560px) {
    .lb__title { display: none; }
    .lb__bar { justify-content: flex-end; }
  }

  @media (prefers-reduced-motion: reduce) {
    .lbLink { transition: none; }
    .lbLink:hover { transform: none; }
  }
</style>
