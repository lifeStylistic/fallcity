---
/* ===========================================================================
   LIGHTBOX
   ---------------------------------------------------------------------------
   Opens one image full-screen, with a zoom that goes to the file's native
   pixels so fine drawing text can actually be read.

   PROGRESSIVE BY DESIGN: what renders is an ordinary link straight to the
   image file. With JavaScript off — or before the script runs — clicking it
   opens the image, which is a perfectly good outcome. The script only
   upgrades that link into a dialog.

   Built on <dialog> deliberately: showModal() gives the focus trap, the
   Escape handler, the inert background and the focus restore for free, and
   the top layer escapes both the ancestor transforms of the reveal system
   and the body's overflow-x: clip. Hand-rolling any of that would be worse.
=========================================================================== */
const {
  id,
  src,
  alt,
  width,
  height,
  linkText,
  caption = '',
  note = '',
} = Astro.props;
---

<a class="lbLink" href={src} data-lightbox={id}>
  <svg class="lbLink__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5"
          stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
  <span>{linkText}</span>
</a>

<dialog class="lb" id={id} aria-label={linkText}>
  <div class="lb__bar">
    <p class="lb__title">{linkText}</p>
    <div class="lb__tools">
      <button class="lb__btn" type="button" data-lb-zoom aria-pressed="false">
        Zoom in
      </button>
      <button class="lb__btn lb__btn--close" type="button" data-lb-close>
        <span class="visually-hidden">Close</span>
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" width="18" height="18">
          <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </div>

  <div class="lb__stage" data-lb-stage>
    <img src={src} alt={alt} width={width} height={height} decoding="async" />
  </div>

  {(caption || note) && (
    <div class="lb__foot">
      {caption && <p class="lb__caption">{caption}</p>}
      {note && <p class="lb__note">{note}</p>}
    </div>
  )}
</dialog>

<style>
  /* --- the trigger ------------------------------------------------------ */
  .lbLink {
    display: inline-flex; align-items: center; gap: 0.55rem;
    margin-top: var(--space-md);
    font-size: var(--fs-small); font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--gold);
    text-decoration: none;
    padding: 0.6rem 0.95rem 0.6rem 0.8rem;
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: var(--radius);
    background: rgba(255, 255, 255, 0.04);
    transition:
      background var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease),
      transform var(--dur-fast) var(--ease);
  }
  .lbLink:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.4);
    transform: translateY(-1px);
  }
  .lbLink__icon { width: 1rem; height: 1rem; flex: none; }

  /* --- the dialog ------------------------------------------------------- */
  .lb {
    width: 100vw; max-width: 100vw;
    height: 100dvh; max-height: 100dvh;
    margin: 0; padding: 0; border: 0;
    background: #140d24;
    color: #fff;
    /* grid, not flow: the stage takes whatever the bar and footer leave, so
       the image is never pushed off the bottom of the screen. */
    display: grid;
    grid-template-rows: auto 1fr auto;
    overflow: hidden;
  }
  .lb:not([open]) { display: none; }
  .lb::backdrop { background: rgba(10, 6, 18, 0.92); }

  .lb__bar {
    display: flex; align-items: center; justify-content: space-between;
    gap: var(--space-md);
    padding: 0.85rem var(--gutter);
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }
  .lb__title {
    font-size: var(--fs-eyebrow); font-weight: 700;
    letter-spacing: 0.16em; text-transform: uppercase;
    color: var(--gold);
  }
  .lb__tools { display: flex; align-items: center; gap: 0.5rem; flex: none; }

  .lb__btn {
    font: inherit; font-size: 0.78rem; font-weight: 600;
    color: #fff; background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: var(--radius);
    padding: 0.5rem 0.85rem;
    cursor: pointer;
    transition: background var(--dur-fast) var(--ease);
  }
  .lb__btn:hover { background: rgba(255, 255, 255, 0.18); }
  .lb__btn--close { display: grid; place-items: center; padding: 0.5rem; }

  /* --- the image stage -------------------------------------------------- */
  .lb__stage {
    overflow: auto;
    display: grid; place-items: center;
    padding: var(--space-md);
    /* Let touch users pinch the drawing rather than trapping the gesture. */
    touch-action: pan-x pan-y pinch-zoom;
    -webkit-overflow-scrolling: touch;
  }
  .lb__stage img {
    max-width: 100%; max-height: 100%;
    width: auto; height: auto;
    object-fit: contain;
    border-radius: var(--radius);
    cursor: zoom-in;
  }
  /* Zoomed: native pixels, and the stage becomes the scroll window. */
  .lb__stage.is-zoomed { place-items: start; }
  .lb__stage.is-zoomed img {
    max-width: none; max-height: none;
    width: var(--natural-width);
    cursor: grab;
    border-radius: 0;
  }
  .lb__stage.is-panning img { cursor: grabbing; }

  .lb__foot {
    padding: 0.9rem var(--gutter) 1.15rem;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    display: grid; gap: 0.4rem;
  }
  .lb__caption {
    font-size: var(--fs-small); line-height: 1.5;
    color: rgba(255, 255, 255, 0.86);
    max-width: 80ch;
  }
  /* The standing caveat. Held at a readable contrast on purpose — this is the
     line that keeps the drawing from reading as a confirmed design. */
  .lb__note {
    font-size: 0.78rem; line-height: 1.5;
    color: rgba(255, 255, 255, 0.68);
    max-width: 80ch;
    padding-left: 0.7rem;
    border-left: 2px solid var(--gold);
  }

  @media (max-width: 560px) {
    .lb__title { display: none; }
    .lb__bar { justify-content: flex-end; }
  }

  @media (prefers-reduced-motion: reduce) {
    .lbLink { transition: none; }
    .lbLink:hover { transform: none; }
  }
</style>

<script is:inline>
  (function () {
    document.querySelectorAll('[data-lightbox]').forEach(function (link) {
      var dlg = document.getElementById(link.getAttribute('data-lightbox'));
      if (!dlg || typeof dlg.showModal !== 'function') return;   /* keep the plain link */

      var stage = dlg.querySelector('[data-lb-stage]');
      var img = stage.querySelector('img');
      var zoomBtn = dlg.querySelector('[data-lb-zoom]');

      link.addEventListener('click', function (e) {
        e.preventDefault();
        dlg.showModal();
      });

      dlg.querySelector('[data-lb-close]').addEventListener('click', function () {
        dlg.close();
      });

      /* Clicking the backdrop closes. The dialog fills the viewport, so the
         only clicks that land on the element itself are outside its grid
         rows — which is exactly the backdrop area. */
      dlg.addEventListener('click', function (e) {
        if (e.target === dlg) dlg.close();
      });

      function setZoom(on) {
        stage.classList.toggle('is-zoomed', on);
        zoomBtn.setAttribute('aria-pressed', String(on));
        zoomBtn.textContent = on ? 'Fit to screen' : 'Zoom in';
        if (on) {
          /* Not simply naturalWidth: on a wide monitor the fitted view is
             already close to native, so "zoom" would do nothing. Go to at
             least twice the width the image currently occupies, so the
             dimension tables get bigger on every screen size. */
          var target = Math.max(img.naturalWidth, Math.round(stage.clientWidth * 2));
          stage.style.setProperty('--natural-width', target + 'px');
          /* Open centred on the middle of the drawing rather than its corner. */
          stage.scrollLeft = (stage.scrollWidth - stage.clientWidth) / 2;
          stage.scrollTop = (stage.scrollHeight - stage.clientHeight) / 2;
        } else {
          stage.scrollTo(0, 0);
        }
      }

      zoomBtn.addEventListener('click', function () {
        setZoom(!stage.classList.contains('is-zoomed'));
      });
      img.addEventListener('click', function () {
        if (!stage.classList.contains('is-zoomed')) setZoom(true);
      });

      /* Drag to pan while zoomed — a mouse has no other way to move around a
         drawing that is wider than the window. */
      var panning = false, sx = 0, sy = 0, sl = 0, st = 0;
      img.addEventListener('pointerdown', function (e) {
        if (!stage.classList.contains('is-zoomed') || e.pointerType === 'touch') return;
        panning = true; sx = e.clientX; sy = e.clientY;
        sl = stage.scrollLeft; st = stage.scrollTop;
        stage.classList.add('is-panning');
        img.setPointerCapture(e.pointerId);
        e.preventDefault();
      });
      img.addEventListener('pointermove', function (e) {
        if (!panning) return;
        stage.scrollLeft = sl - (e.clientX - sx);
        stage.scrollTop = st - (e.clientY - sy);
      });
      ['pointerup', 'pointercancel'].forEach(function (type) {
        img.addEventListener(type, function () {
          panning = false;
          stage.classList.remove('is-panning');
        });
      });

      /* Always reopen fitted, whatever state it was left in. */
      dlg.addEventListener('close', function () { setZoom(false); });
    });
  })();
</script>
