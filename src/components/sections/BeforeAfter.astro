---
import { BEFORE_AFTER, VISION_IMAGE } from '../../data/content.js';
import MediaPlaceholder from '../MediaPlaceholder.astro';
const { today, vision } = BEFORE_AFTER;
---

<section class="section section--tint" id="the-vision">
  <div class="shell">
    <div class="ba__head" class:list={["reveal-head"]} data-reveal="right">
      <p class="eyebrow">{BEFORE_AFTER.eyebrow}</p>
      <h2 class="headline-lg">{BEFORE_AFTER.headline}</h2>
    </div>

    <div class="ba__grid">
      {/* TODAY */}
      <div class="ba__panel ba__panel--today" data-reveal>
        <div class="ba__label">
          <span class="ba__labelText">{today.label}</span>
          <span class="ba__rule" aria-hidden="true"></span>
        </div>
        <img
          class="ba__photo"
          src="/images/track/track-mud-school-600.jpg"
          srcset="/images/track/track-mud-school-600.jpg 600w, /images/track/track-mud-school-1000.jpg 1000w"
          sizes="(min-width: 900px) 44vw, 88vw"
          alt="Wet mud and loose gravel on the running surface beside the school buildings, with the scoreboard and bleachers visible in the distance."
          width="600"
          height="800"
          loading="lazy"
          decoding="async"
        />
        <ul class="ba__list">
          {today.items.map((item) => <li>{item}</li>)}
        </ul>
      </div>

      {/* THE VISION */}
      <div class="ba__panel ba__panel--vision on-dark" data-reveal>
        <div class="ba__label">
          <span class="ba__labelText">{vision.label}</span>
          <span class="ba__rule" aria-hidden="true"></span>
        </div>
        {VISION_IMAGE.src ? (
          <figure class="ba__figure">
            <img
              class="ba__photo"
              src={`/images/reference/${VISION_IMAGE.src}-1300.jpg`}
              srcset={`/images/reference/${VISION_IMAGE.src}-800.jpg 800w, /images/reference/${VISION_IMAGE.src}-1300.jpg 1300w`}
              sizes="(min-width: 900px) 44vw, 88vw"
              alt={VISION_IMAGE.alt}
              width="1300"
              height="849"
              style="box-shadow: var(--shadow-dark); border-radius: var(--radius);"
              loading="lazy"
              decoding="async"
            />
            {/* The caption is required, not decorative: this shows another
                school's track, and the panel heading says "The Vision". */}
            <figcaption class="ba__caption">{VISION_IMAGE.caption}</figcaption>
          </figure>
        ) : (
          <MediaPlaceholder
            label="[PROPOSED TRACK RENDERING]"
            note="Rendering of the finished Falls City track. Until then, set VISION_IMAGE.src in content.js to show a reference photo of a completed four-lane track."
            ratio="3 / 2"
            variant="dark"
          />
        )}
        <ul class="ba__list">
          {vision.items.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .ba__head { margin-bottom: var(--space-xl); max-width: 34rem; }

  .ba__grid { display: grid; gap: var(--space-md); }

  .ba__panel {
    padding: clamp(1.5rem, 3vw, 2.75rem);
    border-radius: var(--radius-lg);
    position: relative;
  }
  .ba__panel--today {
    background: var(--paper);
    border: 1px solid rgba(75, 46, 131, 0.10);
    box-shadow: var(--shadow-md);
  }
  .ba__panel--vision {
    background: var(--grad-deep);
    color: #fff;
    box-shadow: var(--shadow-xl);
    overflow: hidden;
  }
  /* Gold rake across the vision panel, so the two sides are not merely light
     and dark but lit differently. */
  .ba__panel--vision::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(80% 60% at 85% 0%, rgba(242, 201, 76, 0.14), transparent 65%);
    pointer-events: none;
  }
  .ba__panel--vision > * { position: relative; }

  .ba__label { display: flex; align-items: center; gap: var(--space-sm); margin-bottom: var(--space-md); }
  .ba__labelText {
    font-size: var(--fs-eyebrow); font-weight: 700; letter-spacing: 0.2em;
    text-transform: uppercase; flex: none;
  }
  .ba__panel--today .ba__labelText  { color: var(--muted); }
  .ba__panel--vision .ba__labelText { color: var(--gold); }
  .ba__rule { flex: 1; height: 1px; background: currentColor; opacity: 0.18; }

  /* The photo is portrait and the facing panel still holds a 3:2 placeholder,
     so crop the photo to match rather than letting the two panels diverge in
     height. Remove the aspect-ratio once the rendering replaces it. */
  .ba__photo {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    object-position: center 62%;
    border-radius: var(--radius);
    display: block;
    box-shadow: var(--shadow-md);
  }

  .ba__figure { margin: 0; }
  .ba__caption {
    margin-top: 0.65rem;
    font-size: var(--fs-small);
    line-height: 1.45;
    color: rgba(255, 255, 255, 0.72);
    padding-left: 0.7rem;
    border-left: 2px solid var(--gold);
  }

  .ba__list { margin-top: var(--space-md); display: grid; gap: 0.9rem; }
  .ba__list li {
    display: flex; align-items: flex-start; gap: 0.75rem;
    font-size: var(--fs-body); line-height: 1.45;
    padding-bottom: 0.9rem; border-bottom: 1px solid var(--line);
  }
  .ba__list li:last-child { border-bottom: 0; padding-bottom: 0; }
  .ba__list li::before {
    content: ''; flex: none; width: 1rem; height: 2px; margin-top: 0.7em; background: currentColor;
  }
  .ba__panel--today .ba__list li { color: var(--ink-soft); }
  .ba__panel--today .ba__list li::before { background: var(--muted); opacity: 0.5; }
  .ba__panel--vision .ba__list li { color: rgba(255,255,255,0.9); border-bottom-color: rgba(255,255,255,0.14); }
  .ba__panel--vision .ba__list li::before { background: var(--gold); }

  @media (min-width: 900px) {
    .ba__grid { grid-template-columns: 1fr 1fr; gap: var(--space-lg); }
    /* The vision panel sits slightly lower so the pair reads as a step up. */
    .ba__panel--vision { transform: translateY(2.5rem); }
  }
  @media (prefers-reduced-motion: reduce) {
    .ba__panel--vision { transform: none; }
  }
</style>
