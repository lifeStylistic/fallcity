---
import { WHY_IT_MATTERS, STUDENTS_IMAGE } from '../../data/content.js';
import MediaPlaceholder from '../MediaPlaceholder.astro';
---

<section class="section" id="why-it-matters">
  <div class="shell">
    <div class="why__head" class:list={["reveal-head"]} data-reveal="left">
      <p class="eyebrow">{WHY_IT_MATTERS.eyebrow}</p>
      <h2 class="headline-lg">{WHY_IT_MATTERS.headline}</h2>
    </div>

    <div class="why__layout">
      <div class="why__media" data-reveal>
        {STUDENTS_IMAGE.approved && STUDENTS_IMAGE.src ? (
          <figure class="why__figure">
            <img
              src={`/images/${STUDENTS_IMAGE.src}-1000.jpg`}
              srcset={`/images/${STUDENTS_IMAGE.src}-600.jpg 600w, /images/${STUDENTS_IMAGE.src}-1000.jpg 1000w`}
              sizes="(min-width: 1040px) 34vw, 92vw"
              alt={STUDENTS_IMAGE.alt}
              width="1000"
              height="1250"
              loading="lazy"
              decoding="async"
            />
            <figcaption>{STUDENTS_IMAGE.caption}</figcaption>
          </figure>
        ) : (
          <MediaPlaceholder
            label="[STUDENT ATHLETE PHOTO]"
            note="A Falls City athlete mid-effort — running, jumping, or catching breath. Faces matter more than form here."
            ratio="3 / 4"
          />
        )}
      </div>

      <ul class="why__grid">
        {WHY_IT_MATTERS.pillars.map((p, i) => (
          <li class="why__card" data-reveal style={`--d:${i * 70}ms`}>
            <span class="why__num" aria-hidden="true">{p.number}</span>
            <h3 class="why__title">{p.title}</h3>
            <p class="why__body">{p.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .why__head { margin-bottom: var(--space-xl); max-width: 30rem; }

  .why__figure { margin: 0; }
  .why__figure img { width: 100%; height: auto; display: block; border-radius: var(--radius-lg); box-shadow: var(--shadow-lg); }
  .why__figure figcaption {
    margin-top: 0.7rem;
    font-size: var(--fs-small);
    line-height: 1.45;
    color: var(--muted);
    padding-left: 0.7rem;
    border-left: 2px solid var(--gold);
  }
  .why__layout { display: grid; gap: var(--space-lg); }
  .why__grid { display: grid; gap: var(--space-md); }

  .why__card {
    padding-top: var(--space-md);
    border-top: 2px solid var(--purple);
    transition: transform var(--dur) var(--ease-out);
  }
  .why__card:hover { transform: translateY(-4px); }
  .why__num {
    display: block;
    font-family: var(--font-display);
    font-size: 0.8rem; font-weight: 700; letter-spacing: 0.14em;
    color: var(--gold-ink);   /* 12.8px numerals on a white card — needs the text gold */
    margin-bottom: 0.6rem;
  }
  .why__title { font-size: var(--fs-h3); margin-bottom: 0.6rem; }
  .why__body { color: var(--ink-soft); font-size: var(--fs-body); line-height: 1.55; }

  @media (min-width: 800px) {
    .why__grid { grid-template-columns: 1fr 1fr; gap: var(--space-lg) var(--space-md); }
  }
  @media (min-width: 1040px) {
    .why__layout { grid-template-columns: 0.8fr 1.2fr; gap: var(--space-xl); align-items: start; }
  }
</style>
