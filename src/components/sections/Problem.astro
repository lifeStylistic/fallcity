---
import { PROBLEM } from '../../data/content.js';
import StatBlock from '../StatBlock.astro';
---

<section class="section" id="the-need">
  <div class="shell">
    <div class="problem__head">
      <div class="problem__intro" class:list={["reveal-head"]} data-reveal="left">
        <p class="eyebrow">{PROBLEM.eyebrow}</p>
        <h2 class="headline-lg">{PROBLEM.headline}</h2>
      </div>
      <div class="problem__copy prose" data-reveal>
        {PROBLEM.body.map((p) => <p>{p}</p>)}
      </div>
    </div>

    <div class="problem__stats">
      {PROBLEM.stats.map((s) => (
        <StatBlock value={s.value} unit={s.unit} label={s.label} note={s.note} />
      ))}
    </div>

    <figure class="problem__quote" data-reveal>
      <blockquote>{PROBLEM.pullQuote}</blockquote>
    </figure>
  </div>
</section>

<style>
  .problem__head {
    display: grid; gap: var(--space-lg); align-items: start;
    margin-bottom: var(--space-xl);
  }

  .problem__stats {
    display: grid; gap: var(--space-lg) var(--space-md);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
    border-top: 1px solid var(--line);
    padding-top: var(--space-lg);
  }

  .problem__quote {
    margin: var(--space-xl) 0 0;
    padding-left: clamp(1.25rem, 3vw, 2.5rem);
    border-left: 3px solid var(--gold);
    max-width: 27rem;
  }
  .problem__quote blockquote {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.4vw, 1.9rem);
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.02em;
    color: var(--ink);
    text-wrap: pretty;
  }

  @media (min-width: 900px) {
    .problem__head { grid-template-columns: 1fr 1fr; gap: var(--space-xl); }
    .problem__quote { margin-left: auto; }
  }
</style>
