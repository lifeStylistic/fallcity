---
import { PHASES } from '../../data/content.js';
---

<section class="section section--tint" id="the-plan">
  <div class="shell">
    <div class="phases__head" class:list={["reveal-head"]} data-reveal="left">
      <p class="eyebrow">{PHASES.eyebrow}</p>
      <h2 class="headline-lg">{PHASES.headline}</h2>
      <p class="lead phases__intro">{PHASES.intro}</p>
    </div>

    <!-- Roadmap: a single continuous line with four stops, rather than four
         disconnected cards, so the sequence reads as one path. -->
    <ol class="phases__track">
      {PHASES.items.map((item, i) => (
        <li class={`phase ${i === 0 ? 'phase--current' : ''}`} data-reveal style={`--d:${i * 90}ms`}>
          <div class="phase__meta">
            <span class="phase__num">Phase {item.number}</span>
            <span class="phase__tag">{item.tag}</span>
          </div>
          <div class="phase__marker" aria-hidden="true">
            <span class="phase__dot"></span>
          </div>
          <div class="phase__content">
            <h3 class="phase__title">{item.title}</h3>
            <p class="phase__body">{item.body}</p>
          </div>
        </li>
      ))}
    </ol>

    <aside class="phases__note" data-reveal>
      <p><strong>On the 400-meter question:</strong> {PHASES.feasibilityNote}</p>
    </aside>
  </div>
</section>

<style>
  .phases__head { max-width: 44rem; margin-bottom: var(--space-xl); }
  .phases__intro { margin-top: var(--space-md); }

  .phases__track { display: grid; gap: 0; counter-reset: phase; }

  /* Explicit grid areas. The marker column spans both rows on mobile so the
     connecting line runs the full height of each phase. */
  .phase {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    grid-template-areas:
      "marker meta"
      "marker content";
    column-gap: var(--space-md);
    row-gap: 0.4rem;
    padding-bottom: var(--space-lg);
  }

  .phase__meta    { grid-area: meta; }
  .phase__marker  { grid-area: marker; }
  .phase__content { grid-area: content; }

  .phase__marker { position: relative; display: flex; justify-content: center; padding-top: 0.4rem; }
  .phase__marker::before {
    content: ''; position: absolute; top: 1.4rem; bottom: -1.6rem;
    width: 2px; background: var(--line);
  }
  .phase:last-child .phase__marker::before { display: none; }

  .phase__dot {
    position: relative; z-index: 1; flex: none;
    width: 0.95rem; height: 0.95rem; border-radius: 50%;
    background: var(--paper); border: 2px solid var(--line);
    box-shadow: var(--shadow-xs);
  }
  .phase--current .phase__dot {
    background: var(--grad-gold); border-color: transparent;
    box-shadow:
      0 0 0 5px rgba(242, 201, 76, 0.22),
      0 0 0 11px rgba(242, 201, 76, 0.10),
      0 4px 12px rgba(201, 154, 22, 0.35);
  }

  .phase__meta {
    display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem;
    padding-top: 0.3rem;
  }
  .phase__num {
    font-size: var(--fs-eyebrow); font-weight: 700;
    letter-spacing: 0.16em; text-transform: uppercase; color: var(--purple);
    white-space: nowrap;
  }
  .phase__tag {
    font-size: 0.7rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--muted); background: var(--paper);
    border: 1px solid var(--line); border-radius: var(--radius-pill);
    padding: 0.2rem 0.7rem; white-space: nowrap;
  }
  .phase--current .phase__tag {
    color: var(--ink); background: var(--gold); border-color: var(--gold);
  }

  .phase__title { font-size: var(--fs-h3); margin-bottom: 0.5rem; }
  .phase__body { color: var(--ink-soft); max-width: 60ch; font-size: var(--fs-body); }

  .phases__note {
    margin-top: var(--space-lg);
    padding: var(--space-lg);
    background: var(--paper);
    border-left: 4px solid var(--purple);
    border-radius: 0 var(--radius) var(--radius) 0;
    box-shadow: var(--shadow-sm);
  }
  .phases__note p { font-size: var(--fs-small); color: var(--ink-soft); line-height: 1.6; max-width: 80ch; }
  .phases__note strong { color: var(--ink); }

  @media (min-width: 900px) {
    .phase {
      grid-template-columns: 9.5rem 2.5rem 1fr;
      grid-template-areas: "meta marker content";
      align-items: start;
      column-gap: var(--space-md);
    }
    .phase__meta { flex-direction: column; align-items: flex-end; text-align: right; }
  }
</style>
