---
import { PROCESS } from '../../data/content.js';
import MediaPlaceholder from '../MediaPlaceholder.astro';
const { scope, diligence } = PROCESS;
---

<section class="section" id="how-it-works">
  <div class="shell">
    <div class="proc__head" data-reveal>
      <p class="eyebrow">{PROCESS.eyebrow}</p>
      <h2 class="headline-lg">{PROCESS.headline}</h2>
      <p class="lead proc__intro">{PROCESS.intro}</p>
    </div>

    <!-- ORDER OF OPERATIONS ------------------------------------------- -->
    <ol class="proc__steps">
      {PROCESS.steps.map((s) => (
        <li class="step" data-reveal>
          <span class="step__num" aria-hidden="true">{s.number}</span>
          <div class="step__body">
            <h3 class="step__title">{s.title}</h3>
            <p class="step__text">{s.body}</p>
            <p class="step__why">{s.why}</p>
          </div>
        </li>
      ))}
    </ol>

    <!-- PLANNING SCOPE -------------------------------------------------
         These figures describe what a 400m four-lane build REQUIRES. They
         are a planning target, not a confirmed site measurement — Step 1 is
         what confirms them. Keep the caveat visible if you edit this. -->
    <div class="proc__scope" data-reveal>
      <div class="proc__scopeHead">
        <p class="proc__scopeLabel">{scope.label}</p>
        <p class="proc__scopeCaveat">{scope.caveat}</p>
      </div>
      <dl class="proc__figures">
        {scope.items.map((f) => (
          <div class="figure">
            <dt class="figure__label">{f.label}</dt>
            <dd class="figure__value">
              {f.value}<span class="figure__unit">{f.unit}</span>
            </dd>
          </div>
        ))}
      </dl>
    </div>

    <div class="proc__lower">
      <div class="proc__media" data-reveal>
        <!-- [AERIAL SITE IMAGE] -->
        <MediaPlaceholder
          label="[AERIAL SITE IMAGE]"
          note="Drone shot straight down or at a low oblique angle over the field and existing oval. Best single image for showing partners the footprint."
          ratio="4 / 3"
        />
      </div>

      <!-- DUE DILIGENCE -->
      <div class="proc__diligence" data-reveal>
        <h3 class="proc__diligenceTitle">{diligence.title}</h3>
        <ul class="proc__qa">
          {diligence.items.map((d) => (
            <li>
              <p class="qa__q">{d.q}</p>
              <p class="qa__a">{d.a}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <p class="proc__note" data-reveal>{PROCESS.note}</p>
  </div>
</section>

<style>
  .proc__head { max-width: 46rem; margin-bottom: var(--space-xl); }
  .proc__intro { margin-top: var(--space-md); }

  /* --- Order of operations --- */
  .proc__steps { display: grid; gap: 0; margin-bottom: var(--space-2xl); }

  .step {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-md);
    padding: var(--space-md) 0;
    border-top: 1px solid var(--line);
  }
  .step:last-child { border-bottom: 1px solid var(--line); }

  .step__num {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-weight: 800;
    line-height: 0.9;
    letter-spacing: -0.04em;
    color: var(--purple);
    opacity: 0.28;
    min-width: 1.6ch;
    font-variant-numeric: tabular-nums;
  }

  .step__title { font-size: var(--fs-h3); margin-bottom: 0.4rem; }
  .step__text { color: var(--ink-soft); max-width: 62ch; }
  .step__why {
    margin-top: 0.5rem;
    font-size: var(--fs-small);
    color: var(--muted);
    max-width: 62ch;
    padding-left: 0.85rem;
    border-left: 2px solid var(--gold);
  }

  /* --- Planning scope --- */
  .proc__scope {
    background: var(--purple-deep);
    color: #fff;
    padding: clamp(1.5rem, 4vw, 3rem);
    margin-bottom: var(--space-2xl);
  }
  .proc__scopeLabel {
    font-size: var(--fs-eyebrow); font-weight: 700;
    letter-spacing: 0.18em; text-transform: uppercase; color: var(--gold);
  }
  .proc__scopeCaveat {
    margin-top: 0.5rem;
    font-size: var(--fs-small);
    color: rgba(255,255,255,0.72);
    max-width: 60ch;
  }
  .proc__figures {
    display: grid; gap: var(--space-md);
    margin: var(--space-lg) 0 0;
    padding-top: var(--space-lg);
    border-top: 1px solid rgba(255,255,255,0.18);
  }
  .figure { margin: 0; }
  .figure__label {
    font-size: var(--fs-eyebrow); font-weight: 600;
    letter-spacing: 0.1em; text-transform: uppercase;
    color: rgba(255,255,255,0.6);
    margin-bottom: 0.5rem;
  }
  .figure__value {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3.2vw, 2.4rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.03em;
    color: #fff;
    font-variant-numeric: tabular-nums;
  }
  .figure__unit {
    display: block; margin-top: 0.4rem;
    font-size: 0.7rem; font-weight: 600;
    letter-spacing: 0.16em; text-transform: uppercase; color: var(--gold);
  }

  /* --- Due diligence --- */
  .proc__lower { display: grid; gap: var(--space-lg); align-items: start; }
  .proc__diligenceTitle { font-size: var(--fs-h3); margin-bottom: var(--space-md); }
  .proc__qa { display: grid; gap: var(--space-md); }
  .proc__qa li { padding-left: var(--space-sm); border-left: 2px solid var(--purple); }
  .qa__q { font-weight: 600; color: var(--ink); margin-bottom: 0.25rem; }
  .qa__a { font-size: var(--fs-small); color: var(--muted); line-height: 1.55; }

  .proc__note {
    margin-top: var(--space-xl);
    padding-top: var(--space-md);
    border-top: 1px solid var(--line);
    font-size: var(--fs-small);
    color: var(--muted);
    max-width: 80ch;
  }

  @media (min-width: 560px) {
    .proc__figures { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 900px) {
    .step { grid-template-columns: 5rem 1fr; gap: var(--space-lg); align-items: baseline; }
    .proc__figures { grid-template-columns: repeat(4, 1fr); gap: var(--space-lg); }
    .proc__lower { grid-template-columns: 0.9fr 1.1fr; gap: var(--space-xl); }
  }
</style>
