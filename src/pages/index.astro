---
/* ===========================================================================
   HOMEPAGE
   ---------------------------------------------------------------------------
   Section order. To reorder the page, move these lines. To remove a section,
   delete or comment out its line. All copy lives in src/data/content.js and
   all links/figures in src/config/site.js — you should rarely need to edit
   this file at all.
   =========================================================================== */
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

import Hero from '../components/sections/Hero.astro';
import Problem from '../components/sections/Problem.astro';
import BeforeAfter from '../components/sections/BeforeAfter.astro';
import WhyItMatters from '../components/sections/WhyItMatters.astro';
import Story from '../components/sections/Story.astro';
import Phases from '../components/sections/Phases.astro';
import Process from '../components/sections/Process.astro';
import LifeFlight from '../components/sections/LifeFlight.astro';
import Partners from '../components/sections/Partners.astro';
import HowToHelp from '../components/sections/HowToHelp.astro';
import UnlockChain from '../components/sections/UnlockChain.astro';
import Status from '../components/sections/Status.astro';
import CallToAction from '../components/sections/CallToAction.astro';
---

<Base>
  <Nav />
  <main id="main">
    <Hero />           <!-- 1.  Hero -->
    <Problem />        <!-- 2.  The problem + statistics -->
    <BeforeAfter />    <!-- 3.  Today vs. the vision -->
    <WhyItMatters />   <!-- 4.  Four reasons it matters -->
    <Story />          <!-- 5.  The Falls City story -->
    <Phases />         <!-- 6.  Four project phases -->
    <Process />        <!-- 6b. Order of operations + planning scope -->
    <LifeFlight />     <!-- 7.  Life Flight stewardship -->
    <Partners />       <!-- 7b. Partner logos (white background) -->
    <HowToHelp />      <!-- 8.  Contribution categories -->
    <UnlockChain />    <!-- 9.  One contribution unlocks the next -->
    <Status />         <!-- 10. Project status + funding placeholders -->
    <CallToAction />   <!-- 11. Closing call to action -->
  </main>
  <Footer />           <!-- 12. Contact / footer -->
</Base>
